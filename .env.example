# Database
# Local development (with docker-compose.dev.yml)
DATABASE_URL=postgresql://kyle:kyle@localhost:5433/kyle

# Railway auto-injects DATABASE_URL in production

# Server
PORT=3000

# AI
ANTHROPIC_API_KEY=
# Optional: override the agent model (default: claude-sonnet-4-5)
ANTHROPIC_MODEL=

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Plex sign-in (optional; the Plex button is hidden when unset)
# Any stable random string — it identifies Kyle in Authorized Devices
PLEX_CLIENT_IDENTIFIER=
# Public origin Plex redirects back to (defaults to the WebAuthn origin)
PUBLIC_ORIGIN=

# Media Services (future)
RADARR_HOST=
RADARR_API_KEY=
SONARR_HOST=
SONARR_API_KEY=
