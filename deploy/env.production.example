# Written by .github/workflows/deploy.yml from GitHub Actions secrets.
# This file shows the shape only — never commit real values.

# Domain + auth
APP_URL=https://kyle.vhtm.eu
WEBAUTHN_ORIGIN=https://kyle.vhtm.eu
WEBAUTHN_RP_ID=kyle.vhtm.eu
JWT_SECRET=replace-me
CHAT_API_KEY=replace-me
THREAD_VIEWER_TOKEN=replace-me
WEBHOOK_AUTH=user:password

# Database (on shared Postgres in vhtm-eu)
DATABASE_URL=postgresql://kyle:replace-me@postgres:5432/kyle

# AI
ANTHROPIC_API_KEY=replace-me
# Optional: override the agent model (default: claude-sonnet-4-5)
#ANTHROPIC_MODEL=
# Set by the deploy workflow to the deployed commit SHA; surfaced at /health
#DEPLOY_ID=
BRAVE_API_KEY=replace-me

# Slack
SLACK_BOT_TOKEN=replace-me
SLACK_SIGNING_SECRET=replace-me

# Discord
DISCORD_BOT_TOKEN=replace-me

# Media services
RADARR_HOST=
RADARR_API_KEY=replace-me
SONARR_HOST=
SONARR_API_KEY=replace-me
TMDB_API_TOKEN=replace-me

# Torrent + downloads
QBITTORRENT_HOST=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=replace-me
ULTRA_HOST=
ULTRA_API_TOKEN=replace-me

# Plex
PLEX_CLIENT_IDENTIFIER=replace-me
PLEX_SERVER_URL=
PLEX_SERVER_TOKEN=replace-me

# Compose project / port mapping
KYLE_APP_HOST_PORT=3003
COMPOSE_PROJECT_NAME=kyle
